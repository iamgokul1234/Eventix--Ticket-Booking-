{
  "name": "ticket-booking-system",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.17.0",
    "npm": ">=10.0.0"
  },
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "test": "npm run test --workspace=server",
    "lint": "npm run lint --workspace=client",
    "seed": "npm run seed --workspace=server",
    "seed:admin": "npm run seed:admin --workspace=server"
  },
  "dependencies": {
    "typescript": "5.7.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
