{
  "name": "server",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.17.0",
    "npm": ">=10.0.0"
  },
  "private": true,
  "scripts": {
    "dev": "tsx watch -r dotenv/config src/index.ts dotenv_config_path=../.env",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "seed": "tsx -r dotenv/config src/scripts/seed.ts dotenv_config_path=../.env",
    "seed:admin": "tsx -r dotenv/config src/scripts/seedAdmin.ts dotenv_config_path=../.env"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.4",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.10",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "supertest": "^7.0.0",
    "tsx": "^4.15.7",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  }
}
