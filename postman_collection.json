            }
          }
        }
      ]
    },
    {
      "name": "6. Cancellation & Refund Flow",
      "item": [
        {
          "name": "Cancel Booking & Process Refund (Idempotent - Initial Request)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var key = 'cancel-' + pm.variables.replaceIn('{{$guid}}');",
                  "pm.collectionVariables.set('last_cancel_key', key);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.expect(jsonData.data.booking.status).to.eql('CANCELLED');",
                  "pm.collectionVariables.set('cancel_refund_tx', jsonData.data.refundTransactionId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{last_cancel_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/bookings/{{booking_id}}",
              "host": ["{{base_url}}"],
              "path": ["bookings", "{{booking_id}}"]
            }
          }
        },
        {
          "name": "Re-send Cancellation (Duplicate Idempotency - Assert Same Refund Tx ID)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK (Cached Response)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('IDEMPOTENCY INVARIANT: Same refund transaction ID returned (no double credit)', function () {",
                  "    var expectedRefundTx = pm.collectionVariables.get('cancel_refund_tx');",
                  "    pm.expect(jsonData.data.refundTransactionId).to.eql(expectedRefundTx);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{last_cancel_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/bookings/{{booking_id}}",
              "host": ["{{base_url}}"],
              "path": ["bookings", "{{booking_id}}"]
            }
          }
        },
        {
          "name": "New Cancellation Request on Already-Cancelled Booking (Conflict 409 INVALID_STATE_TRANSITION)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 409 Conflict', function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.expect(jsonData.error.code).to.eql('INVALID_STATE_TRANSITION');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "new-cancel-key-{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/bookings/{{booking_id}}",
              "host": ["{{base_url}}"],
              "path": ["bookings", "{{booking_id}}"]
            }
          }
        }
      ]
    },
