            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Wallet balance updated', function () {",
                  "    pm.expect(jsonData.data.walletBalance).to.be.a('number');",
                  "    pm.collectionVariables.set('topup_balance_after', jsonData.data.walletBalance);",
