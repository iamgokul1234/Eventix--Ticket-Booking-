          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK (Cached Stored Response)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('IDEMPOTENCY INVARIANT: Balance remains UNCHANGED (no double credit)', function () {",
                  "    var expectedBalance = pm.collectionVariables.get('topup_balance_after');",
                  "    pm.expect(jsonData.data.walletBalance).to.eql(expectedBalance);",
                  "});"
